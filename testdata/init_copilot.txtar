# Copilot installation uses the process boundary without launching a runtime.
exec git init -q -b main repo
cd repo
exitcode 2 solomonar init --runtime copilot --ext none
! stdout .
stderr '^error: init needs a confirmation \(interactive_required\)$'
! exists .solomonar
! exec git rev-parse --verify --quiet refs/heads/workflow-state

# Results go to stdout, the missing-remote warning to stderr.
exec solomonar init --runtime copilot --ext none --yes
stdout '^Initialized solomonar \d+\.\d+\.\d+ in .+/repo$'
stdout '^  32 files created$'
stdout '^  2\. Start a top-level GitHub Copilot CLI session in .+/repo:$'
stdout '^       /solomonar Explore the next useful flow\.$'
stdout 'git add AGENTS.md \.github/skills/prototype/SKILL.md '
! stdout 'warning:'
stderr '^warning: no remote "origin"; the registry stays local$'
! stderr 'Initialized'
exists .github/skills/solomonar/SKILL.md .github/agents/implementer.agent.md
! exists .github/agents/orchestrator.agent.md
! exists CLAUDE.md .codex
grep '"copilot":' .solomonar/manifest.json
grep '"owner": "runtime:copilot"' .solomonar/manifest.json
cmp docs/solomonar/skills/solomonar/SKILL.md $ASSETS/framework/skills/solomonar/SKILL.md

# An unchanged rerun needs no confirmation and preserves files and the registry.
cp .solomonar/manifest.json ../manifest-before.json
cp .github/skills/solomonar/SKILL.md ../skill-before.md
exec git rev-parse refs/heads/workflow-state
cp stdout ../tip-before.txt
exec solomonar init
stdout '^Already initialized with solomonar \d+\.\d+\.\d+; nothing to do\.$'
stdout '^  31 files unchanged, 1 skipped · registry refs/heads/workflow-state unchanged$'
cmp .solomonar/manifest.json ../manifest-before.json
cmp .github/skills/solomonar/SKILL.md ../skill-before.md
exec git rev-parse refs/heads/workflow-state
cmp stdout ../tip-before.txt

# JSON stays on stdout, with warnings inside the envelope.
exec solomonar init --json
stdout '"ok": true'
stdout '"command": "init"'
stdout '"copilot"'
stdout '"owner": "runtime:copilot"'
! stdout 'Already initialized'
! stderr .
