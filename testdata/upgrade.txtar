# Upgrade a v0.1.7 project with go and claude (generated by solomonar 0.1.7, reduced to the files that
# matter here: the core files it lacks are created) to the extension store.
cd repo
exec git init -q -b main

# Without a terminal the plan needs --yes.
exitcode 2 solomonar upgrade
! stdout .
stderr '^error: upgrade needs a confirmation \(interactive_required\)$'

# The dry run prints every file line and writes nothing.
exec solomonar upgrade --dry-run
stdout '^Upgrade framework 0\.1\.7 → \d+\.\d+\.\d+$'
stdout '^  create     docs/solomonar/extensions/go/extension\.json$'
stdout '^  remove     docs/solomonar/skills/go/SKILL\.md$'
stdout '^  update     \.claude/skills/go/SKILL\.md$'
stdout '^  update     AGENTS\.md$'
stdout '^  skip       docs/README\.md$'
stdout '^Would upgrade solomonar 0\.1\.7 → .+ in .+repo$'
stdout '^  \d+ files created, 3 updated, 5 removed, 3 unchanged, 1 skipped$'
exists docs/solomonar/skills/go/SKILL.md
! exists docs/solomonar/extensions

# A project edit of the no-longer-offered skill is a conflict; nothing is written.
cp ../edited.md docs/solomonar/skills/go/SKILL.md
exitcode 4 solomonar upgrade --yes
stdout '^  conflict   docs/solomonar/skills/go/SKILL\.md  modified since installation \(manifest sha256 differs\)$'
stderr '^error: upgrade found 1 conflict \(file_conflict\)$'
stderr '^  fix:   rerun with --keep <path> to keep the project''s file, or --take-new <path> to take the new version$'
! exists docs/solomonar/extensions

# --keep leaves the edit in place and untracks it; the rest moves to the store.
exec solomonar upgrade --yes --keep docs/solomonar/skills/go/SKILL.md
stdout '^Upgraded solomonar 0\.1\.7 → .+ in .+repo$'
stdout '^  \d+ files created, 3 updated, 4 removed, 1 kept, 3 unchanged, 1 skipped$'
stdout '^  1\. git add AGENTS\.md \.claude \.solomonar docs && git commit -m "chore: upgrade solomonar to .+"$'
stdout '^  2\. Running tasks pick up the new framework after they update from main\.$'
! stderr .
cmp docs/solomonar/skills/go/SKILL.md ../edited.md
! exists docs/solomonar/skills/go/rules
cmp docs/solomonar/extensions/go/SKILL.md $ASSETS/extensions/language/go/SKILL.md
cmp docs/solomonar/extensions/go/extension.json $ASSETS/extensions/language/go/extension.json
grep 'Load `docs/solomonar/extensions/go/SKILL.md`' .claude/skills/go/SKILL.md
grep '^Body edits apply directly; the name and description come from the solomonar release\.$' .claude/skills/go/SKILL.md
grep '^  - `go` \(language, P/D-1\): ' AGENTS.md
! grep 'docs/solomonar/skills/go/' .solomonar/manifest.json
cmp docs/decisions.md ../decisions.md
! exec git rev-parse --verify --quiet refs/heads/workflow-state

# A second run is a no-op.
cp .solomonar/manifest.json ../manifest.json
exec solomonar upgrade
stdout '^Already at solomonar .+; nothing to do\.$'
cmp .solomonar/manifest.json ../manifest.json

# A manifest from a newer release is cli_outdated.
cp ../newer.json .solomonar/manifest.json
exitcode 3 solomonar upgrade --yes
stderr '^error: upgrade rejected \(cli_outdated\)$'
stderr '^  fix:   install a newer solomonar release$'

# Without a manifest the project is not initialized.
rm .solomonar/manifest.json
exitcode 3 solomonar upgrade --yes
stderr '^error: upgrade rejected \(not_initialized\)$'
stderr '^  fix:   run solomonar init$'

