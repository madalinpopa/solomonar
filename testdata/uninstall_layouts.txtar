# Uninstall removes a core-only installation and a v0.1.7 layout (reduced to the files that matter here)
# without a prior upgrade.
exec git init -q -b main core
cd core
exec solomonar init --runtime none --ext none --yes
exec git rev-parse refs/heads/workflow-state
cp stdout ../core-tip.txt
exec solomonar uninstall --yes
stdout '^Uninstalled solomonar from .+/core$'
stdout '^  1 file updated, 39 removed$'
stdout '^  kept: docs/README\.md$'
! exists .solomonar docs/solomonar AGENTS.md
exists docs/README.md
! grep 'docs/solomonar/' docs/README.md
exec git rev-parse refs/heads/workflow-state
cmp stdout ../core-tip.txt

cd ../legacy
exec git init -q -b main
exec solomonar uninstall --dry-run
stdout '^  remove     docs/solomonar/skills/go/SKILL\.md$'
stdout '^  remove     \.claude/skills/go/SKILL\.md$'
stdout '^  remove     AGENTS\.md$'
stdout '^  update     docs/README\.md  framework index line removed$'
stdout '^Would uninstall solomonar from .+/legacy$'
exists docs/solomonar/skills/go/SKILL.md
exec solomonar uninstall --yes
stdout '^Uninstalled solomonar from .+/legacy$'
stdout '^  1 file updated, 6 removed$'
! exists .solomonar docs/solomonar .claude/skills CLAUDE.md AGENTS.md
cmp docs/README.md ../README-after.md
cmp docs/decisions.md ../decisions.md
exec solomonar uninstall
stdout '^No Solomonar manifest; nothing to uninstall automatically\.$'

-- README-after.md --
